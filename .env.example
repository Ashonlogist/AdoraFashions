# ---------------------------------------------------------------------------
# Adora Fashions — environment variables
#
# Copy to `.env.local` for local work, or paste these into
# Vercel → Project → Settings → Environment Variables.
#
# `.env*` files are git-ignored. Never commit a real token.
# ---------------------------------------------------------------------------

# --- Server only (Vercel). No VITE_ prefix: these must never reach the browser.

# A GitHub personal access token with `contents:write` on this one repository.
# Fine-grained token → Repository access → Contents: Read and write.
GITHUB_TOKEN=

# The repository the dashboard commits to.
GITHUB_OWNER=Ashonlogist
GITHUB_REPO=AdoraFashions
GITHUB_BRANCH=main

# The password for /admin. Anything long and unguessable.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this logs you out everywhere.
SESSION_SECRET=

# --- Public (safe to expose, shipped to the browser)

# Your Formspree form id from https://formspree.io — e.g. "xpwzgkqy".
# Leave blank and the contact form falls back to opening the visitor's mail app.
VITE_FORMSPREE_ID=
